# Keamanan tambahan (lihat brief butir 31): pastikan file yang diupload
# ke folder ini tidak pernah bisa dieksekusi sebagai script, apa pun
# ekstensinya. Validasi extension/MIME/size tetap dilakukan di PHP
# (lihat includes/functions.php - handleAttachmentUploads).

<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh|asp|aspx)$">
    Require all denied
</FilesMatch>

Options -ExecCGI
php_flag engine off
